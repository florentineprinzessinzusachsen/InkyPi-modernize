ARG CODENAME=trixie
FROM debian:${CODENAME}

ARG CODENAME=trixie

# Install base dependencies needed by install.sh
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo \
    lsb-release \
    ncurses-bin \
    curl \
    git \
    ca-certificates \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Add the Raspberry Pi OS apt repo so Pi-only packages resolve.
#
# NOTE: [trusted=yes] is a sim-only workaround for Debian Trixie's sqv
# rejecting the SHA1 signature used by archive.raspberrypi.com.  Real Pi OS
# ships its own patched apt that does NOT hit this issue — do NOT copy this
# line to production configs.
#
# apt-get update is intentionally omitted here — install.sh runs its own
# apt-get update after this repo is visible, which picks up the Pi OS index.
# Omitting a standalone update satisfies DS-0017 (apt-get update must be
# combined with apt-get install in the same RUN layer).
RUN echo "deb [trusted=yes] http://archive.raspberrypi.com/debian/ ${CODENAME} main" \
    > /etc/apt/sources.list.d/raspi.list

# Install a no-op raspi-config shim so install.sh's `raspi-config nonint …`
# calls succeed without real hardware or the full raspi-config package.
RUN printf '#!/bin/sh\n# sim-only no-op raspi-config shim\nexit 0\n' \
    > /usr/sbin/raspi-config \
    && chmod +x /usr/sbin/raspi-config

# install.sh's enable_interfaces() reads /boot/firmware/config.txt (or
# /boot/config.txt) and will exit 1 if neither exists. Create a minimal stub
# that looks like a Pi boot config so the sed/grep lines operate on real data
# — same workaround Dockerfile.install-matrix uses.
RUN mkdir -p /boot/firmware \
    && printf '%s\n' \
        '# sim-only /boot/firmware/config.txt stub' \
        'dtparam=audio=on' \
        'dtparam=spi=off' \
        'dtparam=i2c_arm=off' \
    > /boot/firmware/config.txt

# Install a no-op systemctl shim that swallows the handful of calls
# install.sh makes (daemon-reload, enable, is-active, disable, start, stop)
# — same workaround Dockerfile.install-matrix uses. A container has no
# running systemd, so the real systemctl binary (were it installed) would
# error on every call anyway. The shim always exits 0 except for
# `is-active` (exits 3 = "not active") so install.sh's `stop_service` takes
# the "not running" branch. On bullseye/bookworm/trixie `/bin` is a
# usrmerge symlink to `/usr/bin`, so overwriting `/usr/bin/systemctl` also
# covers `/bin/systemctl` (same inode) — no extra `ln` needed.
RUN printf '%s\n' \
        '#!/bin/sh' \
        '# sim-only no-op systemctl shim' \
        'case "$1" in' \
        '  is-active) exit 3 ;;' \
        '  *) exit 0 ;;' \
        'esac' \
    > /usr/bin/systemctl \
    && chmod +x /usr/bin/systemctl

RUN useradd --create-home --shell /bin/bash inkypi-ci \
    && printf 'inkypi-ci ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/inkypi-ci \
    && chmod 0440 /etc/sudoers.d/inkypi-ci

# Copy the local checkout into the image so we exercise the branch under test,
# not whatever is on GitHub.
COPY --chown=inkypi-ci:inkypi-ci . /InkyPi

USER inkypi-ci

# This image is a local sim-install container, not a long-running service.
# HEALTHCHECK NONE suppresses the DS-0026 "missing healthcheck" alert.
HEALTHCHECK NONE

# JTN-699: `.dockerignore` excludes `.git`, so the COPY above leaves this
# tree with no git metadata. install.sh's preflight requires the source tree
# to be a real git clone (needed at runtime by `git describe` and
# update.sh). Initialise a throwaway repo here — same workaround as
# ci_install_matrix_verify.sh uses for Dockerfile.install-matrix — so the
# preflight check reflects the real invariant (ran `git clone …`) without
# bloating the image with the full .git directory.
CMD ["bash", "-c", "if ! git -C /InkyPi rev-parse --git-dir >/dev/null 2>&1; then git -C /InkyPi init --quiet --initial-branch=ci-sim-install && git -C /InkyPi -c user.email=ci@inkypi.local -c user.name=CI -c commit.gpgsign=false -c advice.addIgnoredFile=false commit --allow-empty --quiet -m 'ci-sim-install bootstrap'; fi && cd /InkyPi/install && sudo bash ./install.sh"]
